# Copy this file to `.env` and adjust the values for your machine.
# `.env` is gitignored — never commit real credentials.
#
# This file feeds docker-compose.yml only. It is unrelated to api/.env,
# which is used when running the Spring Boot app directly on the host
# (outside Docker) via ./mvnw or an IDE.

# ---------------------------------------------------------------------------
# PostgreSQL — used only by the `postgres` service to bootstrap the database
# and superuser role on first start.
# ---------------------------------------------------------------------------
POSTGRES_DB=kyofuse
POSTGRES_USER=kyofuse
POSTGRES_PASSWORD=change-me
# Host port DBeaver connects to. Change if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Spring Boot API
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Host port the API is reachable at (http://localhost:API_PORT).
API_PORT=8080
# Host port the Angular frontend is reachable at (http://localhost:APP_PORT).
APP_PORT=4200

# Database connection used by the API itself. Host is the Compose service
# name (`postgres`), NOT localhost — the API reaches Postgres over the
# internal kyofuse-network, never through the host network.
DB_URL=jdbc:postgresql://postgres:5432/kyofuse
DB_APP_USERNAME=kyofuse_app
DB_APP_PASSWORD=change-me
DB_MIGRATION_USERNAME=kyofuse_migration
DB_MIGRATION_PASSWORD=change-me
FLYWAY_ENABLED=true

JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRATION_MINUTES=360
# Both must be base64-encoded 256-bit keys, e.g. `openssl rand -base64 32`.
# Keep them separate: EMAIL_ENCRYPTION_KEY lets the app read emails back (needed to send
# mail); EMAIL_INDEX_SECRET only ever produces a one-way HMAC used for lookup/uniqueness.
EMAIL_ENCRYPTION_KEY=generate-a-base64-256-bit-key
EMAIL_INDEX_SECRET=generate-a-different-base64-256-bit-key
# Base64-encoded 256-bit key used to encrypt the TOTP secret at rest — must be different
# from EMAIL_ENCRYPTION_KEY.
TOTP_ENCRYPTION_KEY=generate-a-different-base64-256-bit-key
# Signs the short-lived "mfa pending" token (issued after password check, before the TOTP
# code is confirmed). Must be a DIFFERENT secret from JWT_SECRET — otherwise a pending 2FA
# token could be replayed as a real access token cookie and skip 2FA entirely.
MFA_JWT_SECRET=generate-a-different-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
STEAM_API_KEY=your-steam-web-api-key

# ---------------------------------------------------------------------------
# Object Storage (MinIO / S3)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=kyofuse_storage_user
STORAGE_SECRET_KEY=kyofuse_storage_secret
STORAGE_BUCKET=kyofuse-media
STORAGE_REGION=us-east-1

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ---------------------------------------------------------------------------
# JVM tuning — keeps the API's memory footprint predictable on dev machines.
# See docker-compose.yml for the rationale behind each flag.
# ---------------------------------------------------------------------------
JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:+UseSerialGC -XX:MaxMetaspaceSize=256m -XX:+ExitOnOutOfMemoryError
