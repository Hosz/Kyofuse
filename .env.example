# Copy this file to `.env` and adjust the values for your machine.
# `.env` is gitignored — never commit real credentials.
#
# This file feeds docker-compose.yml only. It is unrelated to api/.env,
# which is used when running the Spring Boot app directly on the host
# (outside Docker) via ./mvnw or an IDE.

# ---------------------------------------------------------------------------
# PostgreSQL — used only by the `postgres` service to bootstrap the database
# and superuser role on first start.
# ---------------------------------------------------------------------------
POSTGRES_DB=kyofuse
POSTGRES_USER=kyofuse
POSTGRES_PASSWORD=change-me
# Host port DBeaver connects to. Change if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Spring Boot API
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Host port the API is reachable at (http://localhost:API_PORT).
API_PORT=8080

# Database connection used by the API itself. Host is the Compose service
# name (`postgres`), NOT localhost — the API reaches Postgres over the
# internal kyofuse-network, never through the host network.
DB_URL=jdbc:postgresql://postgres:5432/kyofuse
DB_APP_USERNAME=kyofuse_app
DB_APP_PASSWORD=change-me
DB_MIGRATION_USERNAME=kyofuse_migration
DB_MIGRATION_PASSWORD=change-me
FLYWAY_ENABLED=true

JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRATION_MINUTES=360

# ---------------------------------------------------------------------------
# JVM tuning — keeps the API's memory footprint predictable on dev machines.
# See docker-compose.yml for the rationale behind each flag.
# ---------------------------------------------------------------------------
JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:+UseSerialGC -XX:MaxMetaspaceSize=256m -XX:+ExitOnOutOfMemoryError
