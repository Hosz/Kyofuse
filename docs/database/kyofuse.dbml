Project kyofuse {
  database_type: "PostgreSQL"
  note: "Database model for Kyofuse, a CS2 social platform."
}

Table users {
  id uuid [pk]

  first_name varchar(80) [not null]
  last_name varchar(120) [not null]

  email varchar(160) [not null, unique]
  username varchar(40) [not null, unique]

  password_hash varchar(255) [not null]

  role varchar(30) [not null]
  status varchar(30) [not null]

  deactivated_at timestamptz
  deletion_scheduled_at timestamptz

  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table gamer_profiles {
  id uuid [pk]

  user_id uuid [not null, unique, ref: > users.id]

  nickname varchar(40) [not null]
  bio varchar(500)
  avatar_url varchar(500)
  banner_url varchar(500)

  country varchar(80)
  state varchar(80)
  city varchar(80)

  main_role varchar(40)
  secondary_role varchar(40)

  premier_rating int
  faceit_level int
  gc_rank int

  playstyle varchar(40)

  looking_for_team boolean [not null, default: false]
  looking_for_duo boolean [not null, default: false]

  setup_status varchar(30) [not null]

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    nickname
    main_role
    secondary_role
    premier_rating
    faceit_level
    gc_rank
    looking_for_team
    looking_for_duo
    (country, state)
  }
}

Table gamer_profile_favorite_maps {
  id uuid [pk]

  profile_id uuid [not null, ref: > gamer_profiles.id]
  map_name varchar(60) [not null]

  created_at timestamptz [not null]

  indexes {
    (profile_id, map_name) [unique]
    map_name
  }
}

Table posts {
  id uuid [pk]
  community_id uuid [ref: > communities.id, note: 'NULL em post comum; preenchido em post exclusivo de uma comunidade']

  author_id uuid [not null, ref: > users.id]

  content varchar(2000) [not null]
  post_type varchar(40) [not null]
  visibility varchar(40) [not null]
  status varchar(40) [not null]

  reaction_count int [not null, default: 0]
  like_count int [not null, default: 0]
  comment_count int [not null, default: 0]

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    author_id
    post_type
    visibility
    status
    created_at
    (status, visibility, created_at)
  }
}

Table post_maps {
  id uuid [pk]

  post_id uuid [not null, ref: > posts.id]
  map_name varchar(60) [not null]

  created_at timestamptz [not null]

  indexes {
    (post_id, map_name) [unique]
    map_name
  }
}

Table comments {
  id uuid [pk]

  post_id uuid [not null, ref: > posts.id]
  author_id uuid [not null, ref: > users.id]

  content varchar(2000) [not null]
  status varchar(40) [not null]

  reaction_count int [not null, default: 0]
  like_count int [not null, default: 0]

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    post_id
    author_id
    status
    created_at
    (post_id, status, created_at)
  }
}

Table post_reactions {
  id uuid [pk]

  post_id uuid [not null, ref: > posts.id]
  user_id uuid [not null, ref: > users.id]

  reaction_type varchar(40) [not null]

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (post_id, user_id) [unique]
    post_id
    user_id
    reaction_type
  }
}

Table comment_reactions {
  id uuid [pk]

  comment_id uuid [not null, ref: > comments.id]
  user_id uuid [not null, ref: > users.id]

  reaction_type varchar(40) [not null]

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (comment_id, user_id) [unique]
    comment_id
    user_id
    reaction_type
  }
}

Table teams {
  id uuid [pk]

  owner_id uuid [not null, ref: > users.id]

  name varchar(80) [not null]
  slug varchar(100) [not null, unique]
  description varchar(500)

  avatar_url varchar(500)
  banner_url varchar(500)

  region varchar(80)

  min_premier_rating int
  max_premier_rating int

  min_faceit_level int
  max_faceit_level int

  min_gc_rank int
  max_gc_rank int

  status varchar(40) [not null]

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    owner_id
    status
    region
    min_premier_rating
    max_premier_rating
    min_faceit_level
    max_faceit_level
    min_gc_rank
    max_gc_rank
  }
}

Table team_required_roles {
  id uuid [pk]

  team_id uuid [not null, ref: > teams.id]
  role_name varchar(40) [not null]

  created_at timestamptz [not null]

  indexes {
    (team_id, role_name) [unique]
    role_name
  }
}

Table team_members {
  id uuid [pk]

  team_id uuid [not null, ref: > teams.id]
  user_id uuid [not null, ref: > users.id]

  role_in_team varchar(40)
  member_type varchar(40) [not null]
  status varchar(40) [not null]

  joined_at timestamptz [not null]
  left_at timestamptz
  assignment_due_at timestamptz

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    team_id
    user_id
    role_in_team
    member_type
    status
    assignment_due_at
    (team_id, status)
    (team_id, member_type, status)
  }
}

Table team_invites {
  id uuid [pk]

  team_id uuid [not null, ref: > teams.id]
  sender_id uuid [not null, ref: > users.id]
  receiver_id uuid [not null, ref: > users.id]

  status varchar(40) [not null]
  message varchar(500)

  proposed_member_type varchar(40)
  proposed_role_in_team varchar(40)

  canceled_by uuid [ref: > users.id]
  cancellation_reason varchar(500)

  created_at timestamptz [not null]
  responded_at timestamptz
  canceled_at timestamptz

  indexes {
    team_id
    sender_id
    receiver_id
    status
    created_at
    canceled_by
    (receiver_id, status, created_at)
  }
}

Table notifications {
  id uuid [pk]

  user_id uuid [not null, ref: > users.id]
  actor_id uuid [ref: > users.id]

  type varchar(60) [not null]
  title varchar(160) [not null]
  message varchar(500) [not null]
  status varchar(40) [not null]

  target_type varchar(60)
  target_id uuid

  metadata_json jsonb

  created_at timestamptz [not null]
  read_at timestamptz

  indexes {
    user_id
    actor_id
    type
    status
    target_type
    target_id
    created_at
    read_at
    (user_id, status, created_at)
  }
}

Table user_privacy_settings {
  id uuid [pk]

  user_id uuid [not null, unique, ref: > users.id]

  profile_visibility varchar(40) [not null]
  posts_visibility varchar(40) [not null]
  likes_visibility varchar(40) [not null]
  reposts_visibility varchar(40) [not null]
  friends_visibility varchar(40) [not null]
  followers_visibility varchar(40) [not null]
  following_visibility varchar(40) [not null]

  message_permission varchar(40) [not null]
  friend_request_permission varchar(40) [not null]
  follow_permission varchar(40) [not null]
  team_invite_permission varchar(40) [not null]
  duo_invite_permission varchar(40) [not null]

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    user_id
  }
}

Table user_blocks {
  id uuid [pk]

  blocker_id uuid [not null, ref: > users.id]
  blocked_id uuid [not null, ref: > users.id]

  created_at timestamptz [not null]

  indexes {
    (blocker_id, blocked_id) [unique]

    blocker_id
    blocked_id
  }
}

Table user_follows {
  id uuid [pk]

  follower_id uuid [not null, ref: > users.id]
  followed_id uuid [not null, ref: > users.id]

  status varchar(30) [not null]

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (follower_id, followed_id) [unique]

    follower_id
    followed_id
    status
  }
}

Table user_friend_requests {
  id uuid [pk]

  sender_id uuid [not null, ref: > users.id]
  receiver_id uuid [not null, ref: > users.id]

  created_at timestamptz [not null]

  indexes {
    (sender_id, receiver_id) [unique]

    sender_id
    receiver_id
  }
}

Table user_friendships {
  id uuid [pk]

  user_one_id uuid [not null, ref: > users.id]
  user_two_id uuid [not null, ref: > users.id]

  created_at timestamptz [not null]

  indexes {
    (user_one_id, user_two_id) [unique]

    user_one_id
    user_two_id
  }
}

// Toda Team possui obrigatoriamente uma Community, criada automaticamente na criação
// do Team; uma Community, por outro lado, pode existir sem vínculo com nenhum Team.
// team_id é unique para garantir no máximo uma Community por Team (por enquanto).
Table communities {
  id uuid [pk]

  owner_id uuid [not null, ref: > users.id]
  team_id uuid [unique, ref: > teams.id]

  name varchar(80) [not null]
  slug varchar(100) [not null, unique]
  description varchar(500)

  avatar_url varchar(500)
  banner_url varchar(500)

  visibility varchar(20) [not null]
  status varchar(20) [not null]

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    owner_id
    team_id
    visibility
    status
  }
}

// community_members nunca é removida fisicamente: o status é atualizado sobre o mesmo
// registro (sem índice único parcial), para preservar histórico e sustentar BANNED.
Table community_members {
  id uuid [pk]

  community_id uuid [not null, ref: > communities.id]
  user_id uuid [not null, ref: > users.id]

  role varchar(20) [not null]
  status varchar(20) [not null]

  joined_at timestamptz [not null]
  left_at timestamptz

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (community_id, user_id) [unique]

    community_id
    user_id
    role
    status
  }
}

// Espelha user_friend_requests: sem coluna de status, a existência da linha já é o PENDING.
// Aceitar cria/atualiza a linha correspondente em community_members e remove esta; recusar apenas remove.
// Comunidades que o usuário fixou como aba do feed inicial. Preferência pessoal: não
// tem relação com associação (community_members).
Table user_pinned_communities {
  id uuid [pk]

  user_id uuid [not null, ref: > users.id]
  community_id uuid [not null, ref: > communities.id]

  position int [not null, note: 'Ordem da aba no feed, começando em 0']

  created_at timestamptz [not null]

  indexes {
    (user_id, community_id) [unique]

    user_id
    community_id
    (user_id, position)
  }
}

Table community_join_requests {
  id uuid [pk]

  community_id uuid [not null, ref: > communities.id]
  requester_id uuid [not null, ref: > users.id]

  created_at timestamptz [not null]

  indexes {
    (community_id, requester_id) [unique]

    community_id
    requester_id
  }
}

// direct_user_one_id sempre guarda o menor UUID (ordem lexicográfica) entre os dois participantes
// de uma conversa DIRECT, e direct_user_two_id o maior (CHECK direct_user_one_id < direct_user_two_id
// na migration). Isso garante no máximo uma conversa DIRECT por par de usuários, independentemente
// de quem iniciou. Os três campos direct_* e community_id são mutuamente exclusivos conforme o type.
Table conversations {
  id uuid [pk]

  type varchar(20) [not null]

  name varchar(80)
  avatar_url varchar(500) [note: 'Só GROUP: DIRECT usa o avatar do outro participante e COMMUNITY o da comunidade']
  created_by uuid [not null, ref: > users.id]

  community_id uuid [unique, ref: > communities.id]

  direct_user_one_id uuid [ref: > users.id]
  direct_user_two_id uuid [ref: > users.id]
  direct_message_status varchar(20)

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (direct_user_one_id, direct_user_two_id) [unique]

    type
    created_by
    community_id
    direct_user_one_id
    direct_user_two_id
    direct_message_status
    created_at
  }
}

// conversation_members nunca é removida fisicamente: o status é atualizado sobre o mesmo
// registro (sem índice único parcial) — administração da participação feita pela própria FK.
Table conversation_members {
  id uuid [pk]

  conversation_id uuid [not null, ref: > conversations.id]
  user_id uuid [not null, ref: > users.id]

  role varchar(20) [not null]
  status varchar(20) [not null]

  joined_at timestamptz [not null]
  left_at timestamptz
  last_read_at timestamptz

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (conversation_id, user_id) [unique]

    conversation_id
    user_id
    status
  }
}

Table messages {
  id uuid [pk]

  conversation_id uuid [not null, ref: > conversations.id]
  sender_id uuid [not null, ref: > users.id]

  content varchar(2000) [not null]

  created_at timestamptz [not null]

  indexes {
    conversation_id
    sender_id
    created_at
    (conversation_id, created_at)
  }
}

// PostgreSQL partial indexes to be created in Flyway migrations:
//
// CREATE UNIQUE INDEX uk_team_members_active_member
// ON team_members(team_id, user_id)
// WHERE status = 'ACTIVE';
//
// CREATE UNIQUE INDEX uk_team_invites_pending
// ON team_invites(team_id, receiver_id)
// WHERE status = 'PENDING';